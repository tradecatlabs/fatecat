# FateCat 配置模板

# Telegram Bot
FATE_BOT_TOKEN=
FATE_ADMIN_USER_IDS=
FATE_BOT_PROXY_URL=
# 与 FastAPI 同进程的 Telegram Webhook；本地 polling 默认不启用这些配置
FATE_TELEGRAM_WEBHOOK_ENABLED=
FATE_TELEGRAM_WEBHOOK_SECRET=
FATE_TELEGRAM_WEBHOOK_URL=
FATE_PUBLIC_BASE_URL=http://127.0.0.1:8001
FATE_TELEGRAM_WEBHOOK_QUEUE_SIZE=20
FATE_TELEGRAM_WEBHOOK_DEDUPE_SIZE=2048
FATE_TELEGRAM_WEBHOOK_MAX_CONNECTIONS=4
FATE_TELEGRAM_WEBHOOK_STARTUP_TIMEOUT_SECONDS=15
FATE_TELEGRAM_WEBHOOK_RETRY_SECONDS=30

# API 服务
FATE_SERVICE_HOST=127.0.0.1
FATE_SERVICE_PORT=8001
# 逗号分隔 CORS allowlist；默认空列表，不默认放开公网跨域
FATE_CORS_ALLOW_ORIGINS=
# 记录接口 admin token；FATE_API_TOKEN 保留兼容，FATE_API_ADMIN_TOKEN 是推荐显式名称
FATE_API_TOKEN=
FATE_API_ADMIN_TOKEN=
# 用户级 token，格式：user_id:token,user_id2:token2；用户 token 只能访问自己的记录
FATE_API_USER_TOKENS=
# 是否启用用户记录接口和本地 SQLite 记录库；公网纯排盘服务可设为 0
FATE_RECORDS_ENABLED=1
# 公网多租户生产身份必须接外部 OIDC/IdP；本地默认关闭
FATE_PUBLIC_MULTI_TENANT=
FATE_OIDC_ISSUER=
FATE_OIDC_AUDIENCE=
FATE_OIDC_JWKS_URL=
FATE_OIDC_REQUIRED_SCOPES=

# 外部 SIEM / 不可变审计存储；本地默认不启用
FATE_AUDIT_SIEM_EXPORT_ENABLED=
FATE_AUDIT_SIEM_ENDPOINT=
FATE_AUDIT_SIEM_DESTINATION=
FATE_AUDIT_IMMUTABILITY_MODE=

# 记录保留策略；0 表示当前显式删除 baseline
FATE_RECORD_RETENTION_DAYS=0
FATE_RECORD_RETENTION_AUTO_CLEANUP_ENABLED=
FATE_RECORD_RETENTION_DELETE_MODE=
FATE_AUDIT_EVENT_RETENTION_DAYS=180

# 公共服务防护
# 单请求体上限，默认 1MiB
FATE_MAX_REQUEST_BYTES=1048576
# 单请求处理超时，单位秒
FATE_REQUEST_TIMEOUT_SECONDS=30
# 同步命理计算槽位；单实例默认 2，槽位满时 API 返回 503
FATE_MAX_INFLIGHT_CALCULATIONS=2
# 报告任务队列；默认 memory，单副本本地可改为 sqlite 获得跨重启状态查询
FATE_REPORT_JOB_QUEUE_SIZE=20
FATE_REPORT_JOB_WORKERS=1
FATE_REPORT_JOB_TTL_SECONDS=1800
FATE_REPORT_JOB_STORE=memory
FATE_REPORT_JOB_DB_PATH=infra/runtime/local-state/database/report_jobs.sqlite
# 报告任务 webhook callback 默认关闭；本地 smoke 使用模拟 transport，不访问公网
FATE_REPORT_JOB_WEBHOOKS_ENABLED=
FATE_WEBHOOK_TIMEOUT_SECONDS=5
FATE_WEBHOOK_ALLOWED_HOSTS=
FATE_WEBHOOK_ALLOW_HTTP=
# 单 IP 每分钟请求数；0 表示关闭，公网生产不建议关闭
FATE_RATE_LIMIT_PER_MINUTE=120
# 本地默认单副本内存限流；多副本生产必须在网关/Redis/WAF/云侧统一限流
FATE_DEPLOYMENT_REPLICAS=1
FATE_RATE_LIMIT_BACKEND=memory
# 本地通常没有反向代理 body limit；生产应在边缘层开启
FATE_EDGE_BODY_LIMIT_ENABLED=
# 只有在可信反向代理后才打开，打开后使用 X-Forwarded-For 做限流键
FATE_TRUST_PROXY_HEADERS=
# 只有 HTTPS 生产域名确认后打开；本地 HTTP 不应打开
FATE_ENABLE_HSTS=

# Telegram Bot 背压；默认有界队列，用户冷却/每日上限默认关闭
FATE_BOT_MAX_CONCURRENT=1
FATE_BOT_QUEUE_MAX_SIZE=20
FATE_BOT_USER_COOLDOWN_SECONDS=0
FATE_BOT_USER_DAILY_LIMIT=0
