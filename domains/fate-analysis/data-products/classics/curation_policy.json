        "id": "ctext-author",
        "action": "extract_and_exclude",
        "target": "embeddedAuthor",
        "extractMode": "suffix",
        "match": {
          "type": "prefix",
          "value": "作者："
        },
        "classification": "source_metadata",
        "reason": "项目整理时写入的作者字段，应进入文档元数据而非检索正文。"
      },
      {
        "id": "ctext-curation-note",
        "action": "extract_and_exclude",
