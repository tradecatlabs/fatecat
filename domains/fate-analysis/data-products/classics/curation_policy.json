        "extractMode": "suffix",
        "match": {
          "type": "prefix",
          "value": "整理说明："
        },
        "classification": "source_metadata",
        "reason": "项目整理说明不是古籍正文。"
      },
      {
        "id": "ctext-source-url",
        "action": "extract_and_exclude",
        "target": "embeddedSourceUrl",
        "extractMode": "after_label",
        "match": {
          "type": "prefix",
          "value": "来源：https://ctext.org/"
        },
        "classification": "source_metadata",
        "reason": "电子来源 URL 应进入血缘元数据而非检索正文。"
      },
      {
        "id": "ctext-crawl-scope",
        "action": "extract_and_exclude",
        "target": "crawlScope",
        "extractMode": "suffix",
        "match": {
          "type": "prefix",
          "value": "抓取范围："
        },
        "classification": "source_metadata",
        "reason": "抓取范围是数据治理元数据，不是古籍正文。"
      },
      {
        "id": "ctext-chapter-url",
        "action": "extract_and_exclude",
        "target": "chapterSourceUrls",
        "extractMode": "after_label",
        "match": {
          "type": "prefix",
          "value": "来源章节：https://ctext.org/"
        },
        "classification": "source_metadata",
        "reason": "章节来源 URL 应保留为列表元数据，不进入检索正文。"
      }
    ]
  },
