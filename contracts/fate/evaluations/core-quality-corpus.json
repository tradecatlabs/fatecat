{
  "schemaVersion": 1,
  "kind": "fatecat.core_quality_corpus",
  "description": "FateCat 八字/紫微核心质量语料清单。该清单只登记匿名 evaluation fixture、报告结构策略和本地门禁，不保存真实用户样例，不作为生产 provider 输入。",
  "owner": "contracts/fate/evaluations",
  "privacyBoundary": "所有默认样本必须是 synthetic anonymous fixture；用户可见示例和 birthPlace 只允许北京/测试样本；不得登记真实姓名、真实非北京地区、token、secret、DSN 或生产路径。",
  "productionBoundary": "该 corpus 只用于测试、评测和发布门禁。production provider 不得读取 golden fixture 作为业务输入、断语来源或模型答案。",
  "corpora": [
    {
      "id": "corpus.bazi.coverage_matrix",
      "capabilityId": "bazi",
      "datasetId": "dataset.bazi_golden_matrix",
      "path": "domains/fate-analysis/data-products/bazi/golden/coverage_matrix_cases.json",
      "source": "synthetic_anonymous_fixture",
      "usageRole": "evaluation_only",
      "privacyClass": "anonymous_fixture",
      "minCaseCount": 300,
      "requiredBirthPlace": "北京",
      "requiredInputFields": ["birthDateTime", "gender", "longitude", "latitude", "birthPlace"],
      "lockedFields": ["fourPillars", "dayStem", "fortuneStart", "coverageTags", "failureExplanation"],
      "releaseGate": "required",
      "risk": "结构覆盖矩阵只锁工程回归字段，不等于真实命例库或断语正确性证明。"
    },
    {
      "id": "corpus.bazi.rule_depth",
      "capabilityId": "bazi",
      "datasetId": "dataset.bazi_golden_matrix",
      "path": "domains/fate-analysis/data-products/bazi/golden/rule_depth_cases.json",
      "source": "synthetic_anonymous_fixture",
      "usageRole": "evaluation_only",
      "privacyClass": "anonymous_fixture",
      "minCaseCount": 8,
      "requiredBirthPlace": "北京",
      "requiredInputFields": ["birthDateTime", "gender", "longitude", "latitude", "birthPlace"],
      "lockedFields": ["fourPillars", "dayMasterStrength", "gejuMain", "requiredRuleIds", "combinationTopics"],
      "releaseGate": "required",
      "risk": "规则深度样本只证明规则/evidence 字段可追溯，不证明所有八字流派完整覆盖。"
    },
    {
      "id": "corpus.bazi.statement_cases",
      "capabilityId": "bazi",
      "datasetId": "dataset.bazi_golden_matrix",
      "path": "domains/fate-analysis/data-products/bazi/golden/statement_cases.json",
      "source": "synthetic_anonymous_fixture",
      "usageRole": "evaluation_only",
      "privacyClass": "anonymous_fixture",
      "minCaseCount": 8,
      "requiredBirthPlace": "北京",
      "requiredInputFields": ["birthDateTime", "gender", "longitude", "latitude", "birthPlace"],
      "lockedFields": ["fourPillars", "dayMaster", "gejuMain", "accuracyRuleIds"],
      "releaseGate": "required",
      "risk": "轻量陈述样本锁结构化字段和证据，不锁完整报告正文。"
    },
    {
      "id": "corpus.ziwei.basic_cases",
      "capabilityId": "ziwei",
      "datasetId": "dataset.ziwei_golden_cases",
      "path": "domains/fate-analysis/data-products/ziwei/golden/cases.json",
      "source": "synthetic_anonymous_fixture",
      "usageRole": "evaluation_only",
      "privacyClass": "anonymous_fixture",
      "minCaseCount": 12,
      "requiredBirthPlace": "北京",
      "requiredInputFields": ["birthDateTime", "gender", "longitude", "latitude", "birthPlace", "name"],
      "lockedFields": ["palaceCount", "lifePalace", "bodyPalace", "mutagenPlacementCount", "fortuneLinkCount", "requiredRuleIds", "coverageTags"],
      "requiredCoverageTags": [
        "life_body_same_palace",
        "life_body_split",
        "body_in_life_palace",
        "body_migration",
        "body_career_palace",
        "body_spouse_palace",
        "body_fortune_palace",
        "lichun_boundary",
        "midnight_birth",
        "midday_birth",
        "season_spring",
        "season_summer",
        "season_autumn",
        "season_winter",
        "moon_major_star",
        "pojun_life_palace",
        "tanlang_life_palace",
        "wuqu_life_palace",
        "wuqu_tianxiang_life"
      ],
      "releaseGate": "required",
      "risk": "紫微基础样本只锁项目当前盘面 guard 字段与覆盖标签，不代表完整紫微流派评测。"
    },
    {
      "id": "corpus.ziwei.rule_depth",
      "capabilityId": "ziwei",
      "datasetId": "dataset.ziwei_golden_cases",
      "path": "domains/fate-analysis/data-products/ziwei/golden/rule_depth_cases.json",
      "source": "synthetic_anonymous_fixture",
      "usageRole": "evaluation_only",
      "privacyClass": "anonymous_fixture",
      "minCaseCount": 12,
      "requiredBirthPlace": "北京",
      "requiredInputFields": ["birthDateTime", "gender", "longitude", "latitude", "birthPlace", "name"],
      "lockedFields": ["lifePalace", "bodyPalace", "requiredRuleIds", "combinationTopics", "weightedConfidenceMin"],
      "releaseGate": "required",
      "risk": "紫微规则深度样本证明组合规则与冲突解释存在，不证明星曜百科和飞化体系全量完成。"
    }
  ],
  "reportDiffPolicy": {
    "path": "contracts/fate/evaluations/report-diff-policy.json",
    "releaseGate": "required",
    "gate": "policyGate=pass and snapshotGate=pass for production report profiles",
    "requiredStructuralSummary": ["policyGate", "snapshotGate", "headingCount", "requiredHeadings"],
    "forbiddenStoredFields": ["markdown", "content", "body", "fullReport", "reportText"]
  },
  "professionalQualityRubric": {
    "path": "contracts/fate/evaluations/professional-quality-rubric.json",
    "releaseGate": "required",
    "minimumDimensionCount": 8,
    "requiredCapabilities": ["bazi", "ziwei"],
    "requiredEvidenceKinds": ["golden_fixture", "report_diff_summary", "evidence_ref", "privacy_scan", "human_review_note"]
  },
  "releaseGate": {
    "command": "bash scripts/core-quality-corpus-gate.sh",
    "localCiArtifact": "core-quality-corpus-gate.json",
    "required": true
  },
  "limitations": [
    "不锁定完整断语正文。",
    "不新增真实命例。",
    "不宣称八字/紫微专业能力 100%。",
    "不把 evaluation fixture 注入 production provider。"
  ]
}
