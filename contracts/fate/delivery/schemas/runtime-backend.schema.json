{
  "schemaVersion": 1,
  "description": "测算基础设施 RuntimeBackend 资源契约。RuntimeBackend 用于登记 CalculationJob durable runtime 的本地和外部后端候选，明确成熟度、生产边界、证据要求和迁移路径；登记不等于外部 backend 已生产。",
  "requiredRegistryFields": [
    "schemaVersion",
    "apiVersion",
    "resourceType",
    "id",
    "description",
    "decision",
    "schemas",
    "backends",
    "invariants"
  ],
  "requiredRuntimeBackendFields": [
    "resourceType",
    "apiVersion",
    "id",
    "name",
    "backendType",
    "status",
    "maturity",
    "deploymentScope",
    "durability",
    "coordination",
    "productionEligibility",
    "implementationStatus",
    "config",
    "capabilities",
    "requiredEvidence",
    "localVerification",
    "externalVerification",
    "privacyBoundary",
    "externalConnectivity",
    "migration",
    "links",
    "metadata"
  ],
  "requiredDecisionFields": [
    "status",
    "selectedExternalCandidate",
    "firstAdapterPath",
    "futureWorkflowOrchestrator",
    "notSelectedAsSourceOfTruth",
    "nextTask"
  ],
  "requiredCapabilityFields": [
    "jobStatePersistence",
    "eventHistoryPersistence",
    "idempotencyPersistence",
    "taskPayloadRecovery",
    "webhookOutboxPersistence",
    "workerLease",
    "multiReplicaReady",
    "exactlyOnceClaim"
  ],
  "requiredMetadataFields": [
    "owner",
    "rationale",
    "failureMode",
    "releaseImpact",
    "risk"
  ],
  "allowedBackendType": ["memory", "sqlite", "postgres", "temporal", "redis_queue"],
  "allowedStatus": ["available", "planned", "not_selected"],
  "allowedMaturity": ["L0", "L1", "L2", "L3", "L4"],
  "allowedDeploymentScope": ["process_local", "single_replica_local", "external_database", "external_workflow", "external_queue"],
  "allowedImplementationStatus": [
    "implemented",
    "worker_heartbeat_polling_smoke_baseline",
    "public_webhook_live_smoke_gate_baseline",
    "external_worker_restart_smoke_baseline",
    "job_worker_lease_smoke_baseline",
    "worker_lease_smoke_baseline",
    "live_smoke_baseline",
    "adapter_baseline",
    "contract_baseline",
    "planned"
  ],
  "allowedProductionEligibility": ["not_allowed", "single_replica_only", "candidate", "future_orchestrator", "auxiliary_only"],
  "allowedExternalConnectivity": [
    "not_required",
    "external_connectivity_pending",
    "requires_real_database",
    "requires_real_service"
  ],
  "invariants": [
    "RuntimeBackend 资源只登记运行后端契约，不保存用户输入、报告正文、真实 token、secret、DSN、私钥或生产日志",
    "memory 后端不得声明 durable 或 production ready",
    "sqlite 后端只允许 single_replica_only，不得声明生产级分布式 worker lease",
    "postgres 是当前首个 external backend adapter 候选；即使 worker heartbeat/polling smoke baseline 与 multi-replica runtime evidence gate baseline 已落地，status 也必须保持 planned，直到外部 Vault/KMS、公网 webhook passed evidence、长期多副本 runtime live evidence 和 exactly-once 证据完成",
    "temporal 可登记为 future workflow orchestrator，但不能替代当前 ReportJobStore adapter contract",
    "redis_queue 不得作为 CalculationJob source of truth；只允许作为未来辅助队列",
    "任何 external backend 生产通过必须由真实外部数据库或服务、迁移 smoke、crash/restart 证据、worker lease 证据、heartbeat/polling 证据、公网 webhook live passed evidence、外部 secret lifecycle 证据和长期多副本 runtime live evidence 共同证明"
  ]
}
