{
  "schemaVersion": 1,
  "contractId": "contract.external_secret_provider_evidence",
  "description": "外部 secret provider / Vault / KMS 证据契约。本文件只定义证据结构和反伪造边界，不保存真实 secret、token、DSN、webhook URL、KMS key 原值、provider endpoint、审计日志 payload、用户输入或报告正文。",
  "status": "dry_run_contract",
  "externalConnectivity": "external_connectivity_pending",
  "controls": {
    "localFernetWebhookConfig": {
      "controlId": "control.external_secret_provider_kms",
      "baselineMode": "local_fernet_encrypted_config_vault",
      "productionTargetMode": "external_secret_provider_or_kms",
      "requiredForPublicMultiReplica": true,
      "dryRunEvidenceChecks": [
        "本地 Fernet encrypted config vault 只能证明 encrypted-at-rest baseline。",
        "FATE_WEBHOOK_CONFIG_FERNET_KEYS 只能作为本地 key ring baseline，不得伪装成外部 secret manager。",
        "任何 live evidence 不得使用 local_fernet、env_var_only、placeholder 或 static_file_secret 作为 provider/mode/proof。"
      ],
      "localVerification": [
        "bash scripts/webhook-config-vault-smoke.sh",
        "bash scripts/external-secret-provider-gate.sh"
      ]
    },
    "externalSecretProvider": {
      "controlId": "control.external_secret_provider_kms",
      "productionTargetMode": "external_secret_provider_or_kms",
      "allowedProviderTypes": [
        "hashicorp_vault",
        "aws_kms",
        "aws_secrets_manager",
        "gcp_secret_manager",
        "gcp_kms",
        "azure_key_vault",
        "cloud_kms_or_secret_manager"
      ],
      "liveEvidenceSchema": {
        "requiredFields": [
          "mode",
          "providerType",
          "verificationStatus",
          "keyReferenceProofRef",
          "rotationProofRef",
          "accessAuditProofRef",
          "applicationInjectionProofRef",
          "redactionBoundary"
        ],
        "requiredMode": "external_secret_provider",
        "requiredVerificationStatus": "passed_external_secret_provider_check",
        "requiredRedactionBoundary": "redacted_no_secret_values",
        "forbiddenProviderValues": [
          "local_fernet",
          "env_var_only",
          "static_file_secret",
          "FATE_WEBHOOK_CONFIG_FERNET_KEYS",
          "placeholder"
        ],
        "forbiddenProofFragments": [
          "FATE_WEBHOOK_CONFIG_FERNET_KEYS",
          "FATE_WEBHOOK_CONFIG_ACTIVE_KEY_ID",
          "secret assignment marker",
          "token assignment marker",
          "password assignment marker",
          "private key block marker",
          "ssh private key marker",
          "placeholder",
          "changeme",
          "dummy"
        ]
      }
    }
  },
  "negativeEvidenceCases": [
    {
      "id": "fake.local_fernet_as_external",
      "description": "本地 Fernet key ring 不能伪装成外部 secret provider。",
      "evidence": {
        "schemaVersion": 1,
        "kind": "fatecat.external_secret_provider_evidence",
        "status": "external_live_passed",
        "secretProvider": {
          "mode": "external_secret_provider",
          "providerType": "local_fernet",
          "verificationStatus": "passed_external_secret_provider_check",
          "keyReferenceProofRef": "FATE_WEBHOOK_CONFIG_FERNET_KEYS",
          "rotationProofRef": "bash scripts/webhook-config-vault-smoke.sh",
          "accessAuditProofRef": "local smoke",
          "applicationInjectionProofRef": "env var",
          "redactionBoundary": "redacted_no_secret_values"
        }
      },
      "expectedErrorContains": "secretProvider"
    },
    {
      "id": "fake.placeholder_vault",
      "description": "占位 Vault/KMS proof 不能伪装成 live evidence。",
      "evidence": {
        "schemaVersion": 1,
        "kind": "fatecat.external_secret_provider_evidence",
        "status": "external_live_passed",
        "secretProvider": {
          "mode": "external_secret_provider",
          "providerType": "hashicorp_vault",
          "verificationStatus": "passed_external_secret_provider_check",
          "keyReferenceProofRef": "placeholder",
          "rotationProofRef": "evidence://secret-provider/rotation",
          "accessAuditProofRef": "evidence://secret-provider/access-audit",
          "applicationInjectionProofRef": "evidence://secret-provider/app-injection",
          "redactionBoundary": "redacted_no_secret_values"
        }
      },
      "expectedErrorContains": "secretProvider"
    },
    {
      "id": "fake.rotation_without_audit",
      "description": "缺少 access audit proof 的 rotation 不能伪装成生产密钥生命周期证据。",
      "evidence": {
        "schemaVersion": 1,
        "kind": "fatecat.external_secret_provider_evidence",
        "status": "external_live_passed",
        "secretProvider": {
          "mode": "external_secret_provider",
          "providerType": "aws_kms",
          "verificationStatus": "passed_external_secret_provider_check",
          "keyReferenceProofRef": "evidence://secret-provider/key-ref",
          "rotationProofRef": "evidence://secret-provider/rotation",
          "applicationInjectionProofRef": "evidence://secret-provider/app-injection",
          "redactionBoundary": "redacted_no_secret_values"
        }
      },
      "expectedErrorContains": "secretProvider"
    }
  ],
  "liveEvidenceStatus": "外部连通验证待执行",
  "privacyBoundary": "证据契约、gate output 和测试 fixture 不得包含真实 secret、token、DSN、私钥、证书、provider endpoint、KMS key 原值、webhook URL、callback secret、审计日志 payload、请求体、用户输入、出生地区或报告正文。",
  "releaseBoundary": "本契约通过只证明仓库能识别和拒绝伪造的 secret provider evidence；真实生产发布仍需要外部 Vault/KMS/secret manager live evidence、key rotation proof、access audit proof 和 application injection proof。"
}
