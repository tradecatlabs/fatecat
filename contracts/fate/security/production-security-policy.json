{
  "schemaVersion": 1,
  "policyId": "policy.production_identity_siem_retention",
  "description": "生产身份、外部 SIEM、不可变审计存储、retention 自动清理和 OWASP API Security Top 10 回归包准入策略。本文件是本地可验证 contract，不保存真实账号、token、SIEM endpoint 或生产连通结果。",
  "identity": {
    "baselineMode": "scoped_token_rbac",
    "productionTargetMode": "external_oidc_or_idp",
    "requiredForPublicMultiTenant": true,
    "admissionEnvVars": [
      "FATE_PUBLIC_MULTI_TENANT",
      "FATE_OIDC_ISSUER",
      "FATE_OIDC_AUDIENCE",
      "FATE_OIDC_JWKS_URL",
      "FATE_OIDC_REQUIRED_SCOPES"
    ],
    "localFallbackBoundary": "FATE_API_TOKEN、FATE_API_ADMIN_TOKEN 和 FATE_API_USER_TOKENS 只允许作为本地或单租户 scoped token baseline；不得宣称为 OAuth/OIDC 或生产 IdP。",
    "externalConnectivity": "external_connectivity_pending"
  },
  "siem": {
    "requiredForProductionRecords": true,
    "immutableAuditRequired": true,
    "admissionEnvVars": [
      "FATE_AUDIT_SIEM_EXPORT_ENABLED",
      "FATE_AUDIT_SIEM_ENDPOINT",
      "FATE_AUDIT_SIEM_DESTINATION",
      "FATE_AUDIT_IMMUTABILITY_MODE"
    ],
    "allowedImmutabilityModes": ["append_only", "worm", "external_siem"],
    "privacyBoundary": "SIEM export 不得发送 token、请求体、报告正文、姓名、出生地区、recordId、jobId、userId 原文或 webhook secret。",
    "externalConnectivity": "requires_real_credentials"
  },
  "retention": {
    "requiredForPersistentRecords": true,
    "currentRecordMode": "explicit_delete",
    "targetRecordMode": "time_based_cleanup_with_audit",
    "admissionEnvVars": [
      "FATE_RECORD_RETENTION_DAYS",
      "FATE_RECORD_RETENTION_AUTO_CLEANUP_ENABLED",
      "FATE_RECORD_RETENTION_DELETE_MODE",
      "FATE_AUDIT_EVENT_RETENTION_DAYS",
      "FATE_REPORT_JOB_TTL_SECONDS"
    ],
    "allowedDeleteModes": ["tombstone_then_purge", "hard_delete"],
    "localCleanerMode": "sqlite_records_and_report_jobs_smoke",
    "localCleanerCommand": "bash scripts/retention-cleanup-smoke.sh --output-json <path>",
    "localCleanerSummaryKind": "fatecat.retention_cleanup_smoke",
    "localDeleteMode": "hard_delete",
    "localBoundary": "当前已有本地 SQLite records/report jobs 按年龄清理 smoke；若声明生产自动清理，仍必须提供 scheduler、生产数据库、外部 SIEM/不可变审计存储和删除审计 live evidence。",
    "externalConnectivity": "external_connectivity_pending"
  },
  "secretProvider": {
    "baselineMode": "local_fernet_encrypted_config_vault",
    "productionTargetMode": "external_secret_provider_or_kms",
    "requiredForPublicMultiReplica": true,
    "admissionEnvVars": [
      "FATE_EXTERNAL_SECRET_PROVIDER",
      "FATE_EXTERNAL_SECRET_PROVIDER_EVIDENCE",
      "FATE_WEBHOOK_CONFIG_FERNET_KEYS",
      "FATE_WEBHOOK_CONFIG_ACTIVE_KEY_ID"
    ],
    "localBoundary": "FATE_WEBHOOK_CONFIG_FERNET_KEYS 只允许作为本地 encrypted-at-rest key ring baseline；不得宣称为外部 Vault/KMS、secret manager、生产 key rotation 或 access audit。",
    "externalConnectivity": "external_connectivity_pending"
  },
  "owaspApiSecurityTop10_2023": [
    {
      "id": "API1",
      "name": "Broken Object Level Authorization",
      "localCoverage": [
        "tests/regression/test_api_contracts.py::user_token_owner_boundary",
        "scripts/security-smoke.py::user_token_owner_boundary"
      ]
    },
    {
      "id": "API2",
      "name": "Broken Authentication",
      "localCoverage": [
        "tests/regression/test_api_contracts.py::record token tests",
        "scripts/security-smoke.py::records_can_be_disabled"
      ]
    },
    {
      "id": "API3",
      "name": "Broken Object Property Level Authorization",
      "localCoverage": [
        "contracts/fate/capabilities/schemas/output.schema.json",
        "tests/regression/test_api_contracts.py::security registry response contract"
      ]
    },
    {
      "id": "API4",
      "name": "Unrestricted Resource Consumption",
      "localCoverage": [
        "scripts/security-smoke.py::request_body_limit",
        "scripts/security-smoke.py::rate_limit_rejects_second_request"
      ]
    },
    {
      "id": "API5",
      "name": "Broken Function Level Authorization",
      "localCoverage": [
        "tests/regression/test_api_contracts.py::scoped_user_token",
        "contracts/fate/security/registry.json::control.rbac_policy"
      ]
    },
    {
      "id": "API6",
      "name": "Unrestricted Access to Sensitive Business Flows",
      "localCoverage": [
        "contracts/fate/security/registry.json::control.rate_limit",
        "contracts/fate/security/registry.json::control.production_readiness_external"
      ]
    },
    {
      "id": "API7",
      "name": "Server Side Request Forgery",
      "localCoverage": [
        "scripts/webhook-smoke.py",
        "contracts/fate/security/registry.json::control.report_job_webhook_signature"
      ]
    },
    {
      "id": "API8",
      "name": "Security Misconfiguration",
      "localCoverage": [
        "scripts/production-readiness.sh",
        "contracts/fate/security/registry.json::control.response_security_headers"
      ]
    },
    {
      "id": "API9",
      "name": "Improper Inventory Management",
      "localCoverage": [
        "contracts/fate/security/registry.json",
        "tests/regression/test_api_contracts.py::test_security_controls_are_discoverable_and_linked"
      ]
    },
    {
      "id": "API10",
      "name": "Unsafe Consumption of APIs",
      "localCoverage": [
        "contracts/fate/security/registry.json::control.report_job_webhook_signature",
        "contracts/fate/observability/alert-rules.json"
      ]
    }
  ],
  "releaseGate": {
    "localCommand": "bash scripts/production-security-gate.sh",
    "externalizationGateCommand": "bash scripts/security-externalization-gate.sh",
    "externalizationEvidenceContract": "contracts/fate/security/externalization-evidence-contract.json",
    "retentionCleanupSmokeCommand": "bash scripts/retention-cleanup-smoke.sh --output-json <path>",
    "retentionCleanupContract": "contracts/fate/security/retention-cleanup.json",
    "retentionProductionCleanupStagedGate": "bash scripts/retention-production-cleanup-gate.sh",
    "retentionProductionCleanupStagedContract": "contracts/fate/security/retention-production-cleanup-staged.json",
    "externalSecretProviderGateCommand": "bash scripts/external-secret-provider-gate.sh",
    "externalSecretProviderEvidenceContract": "contracts/fate/security/external-secret-provider-contract.json",
    "quickCiRequired": true,
    "blocksPublicReleaseWithoutExternalEvidence": [
      "external_oidc_or_idp",
      "external_siem_or_immutable_audit_storage",
      "time_based_record_retention_cleanup",
      "external_secret_provider_or_kms",
      "production_live_smoke"
    ]
  },
  "privacyBoundary": "策略文件、registry、gate output 和 API 响应不得包含真实 token、secret、DSN、私钥、证书、SIEM endpoint、用户输入或报告正文。"
}
