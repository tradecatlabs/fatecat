{
  "schemaVersion": 1,
  "description": "FateCat secret scanner allowlist. This file only permits known placeholders and non-production reference text; it must not contain real secrets.",
  "excludedPathPrefixes": [
    "tools/reference-repos/",
    "governance/archive/"
  ],
  "placeholderTokens": [
    "<real-token>",
    "<真实域名>",
    "<url>",
    "admin-token",
    "api-token",
    "changeme",
    "dummy",
    "example",
    "fake",
    "placeholder",
    "sample",
    "test-token",
    "user-token",
    "your-token",
    "你的token"
  ],
    "allowedValueFragments": [
        "LLM_API_KEY=sk-your-openai-key-here",
        "FATE_BOT_TOKEN=${placeholder_token}",
        "FATE_BOT_TOKEN=",
        "WEBHOOK_SIGNATURE_HEADER = \"X-FateCat-Webhook-Signature\"",
        "WEBHOOK_TIMESTAMP_HEADER = \"X-FateCat-Webhook-Timestamp\"",
        "WEBHOOK_EVENT_HEADER = \"X-FateCat-Webhook-Event\"",
        "ReportJobWebhookDispatcher = Callable[[ReportJobSnapshot, Any], Any]",
        "webhook_dispatcher: ReportJobWebhookDispatcher | None = None"
    ]
}
