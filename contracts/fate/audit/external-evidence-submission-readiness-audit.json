{
  "schemaVersion": 1,
  "kind": "fatecat.external_evidence_submission_readiness_audit_contract",
  "resourceType": "ExternalEvidenceSubmissionReadinessAudit",
  "id": "audit.external.evidenceSubmissionReadinessAudit",
  "status": "baseline",
  "description": "外部证据提交准备度审计契约。该审计聚合 work queue、proof-ref gate、live proof gate、operator execution packet、core quality human review gate、third-party audit rehearsal 和 certification，输出 current commit 的可提交/待提交/阻断矩阵。它不执行真实 live、不上传证据、不替代 operator、人审或第三方审计。",
  "generator": {
    "command": "bash scripts/external-evidence-submission-readiness-audit.sh --work-queue-json <external-validation-closure-work-queue.json> --proof-ref-gate-json <external-validation-proof-ref-gate.json> --live-proof-gate-json <external-validation-live-proof-gate.json> --operator-packet-json <external-validation-operator-execution-packet.json> --core-quality-human-review-json <core-quality-human-review-gate.json> --third-party-audit-rehearsal-json <third-party-audit-rehearsal.json> --certification-json <measurement-infrastructure-certification.json> --output-json <external-evidence-submission-readiness-audit.json>",
    "pythonEntrypoint": "scripts/external-evidence-submission-readiness-audit.py",
    "defaultOutput": "infra/runtime/local-state/exports/audit/external-evidence-submission-readiness-audit.json"
  },
  "requiredInputs": [
    "fatecat.external_validation_closure_work_queue",
    "fatecat.external_validation_proof_ref_gate_summary",
    "fatecat.external_validation_live_proof_gate_summary",
    "fatecat.external_validation_operator_execution_packet",
    "fatecat.core_quality_human_review_gate",
    "fatecat.third_party_audit_rehearsal",
    "fatecat.measurement_infrastructure_certification"
  ],
  "requiredOutputFields": [
    "schemaVersion",
    "kind",
    "generatedAt",
    "status",
    "submissionReadinessStatus",
    "source",
    "summary",
    "submissionReadinessGate",
    "operatorCommandAudit",
    "readinessMatrix",
    "blockingItems",
    "privacyBoundary",
    "nonClaims"
  ],
  "submissionPolicy": "readiness audit passed 只代表审计器成功聚合当前证据；submissionReadinessGate=passed 才代表所有提交前证据包均结构就绪。即便全部结构就绪，最终 100% 仍必须由真实 live、专家评审、独立审计和 certification canClaim100Percent=true 共同证明。",
  "artifactHashPolicy": {
    "required": true,
    "acceptedPatterns": [
      "sha256:<64 lowercase hex>",
      "<64 lowercase hex>"
    ],
    "operatorTemplatePlaceholder": "sha256:<64 lowercase hex artifact digest>",
    "meaning": "template placeholder 只表示 operator 需要填写真实脱敏 artifact hash；不得当作 evidence accepted。"
  },
  "operatorCommandPolicy": {
    "required": true,
    "requiresCommandSha256": true,
    "allowedCommandSource": "operator packet generated by external-validation-operator-execution-packet"
  },
  "privacyBoundary": "只保存证据产物路径、sha256、gate status、work item/category/owner id、operator command hash、artifact hash 状态和阻断项；不得保存真实 URL、token、secret、DSN、webhook secret、chat id、外部账号、生产日志、trace payload、报告正文或用户输入。",
  "forbiddenFragments": [
    "https://",
    "http://",
    "token=",
    "secret=",
    "password=",
    "passwd=",
    "DATABASE_URL",
    "DB_DSN",
    "api_key=",
    "private_key",
    "BEGIN RSA",
    "BEGIN OPENSSH",
    "placeholder proof",
    "fake proof",
    "dummy proof",
    "localhost proof"
  ],
  "nonClaims": [
    "Does not execute external live checks.",
    "Does not submit proof-ref, live proof or human-review bundles.",
    "Does not prove any production API, HF Space, Bot, webhook, Postgres, OIDC, SIEM, OTel or Vault/KMS live validation has passed.",
    "Does not replace external-validation-proof-ref-gate.",
    "Does not replace external-validation-live-proof-gate.",
    "Does not replace core-quality-human-review-gate.",
    "Does not replace independent third-party audit.",
    "Does not mean FateCat is 100% measurement infrastructure."
  ]
}
