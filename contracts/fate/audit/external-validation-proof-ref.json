{
  "schemaVersion": 1,
  "kind": "fatecat.external_validation_proof_ref_contract",
  "resourceType": "ExternalValidationProofRefGate",
  "id": "audit.external.validation.proofRef",
  "status": "baseline",
  "description": "外部验证 proof-ref 与 evidence upload 契约。该 gate 消费 external validation closure work queue 和可选 operator 提供的脱敏 evidence bundle，只校验证据句柄结构、当前 commit 绑定、work item 绑定、hash、时间窗、redaction 和反伪造边界；不连接真实外部系统，不把 proof-ref 结构通过等同于生产 live 通过。",
  "generator": {
    "command": "bash scripts/external-validation-proof-ref-gate.sh --work-queue-json <external-validation-closure-work-queue.json> [--evidence-json <proof-ref-bundle.json>] --output-json <path>",
    "pythonEntrypoint": "scripts/external-validation-proof-ref-gate.py",
    "defaultOutput": "infra/runtime/local-state/exports/audit/external-validation-proof-ref-gate.json"
  },
  "inputSchema": "contracts/fate/audit/schemas/external-validation-proof-ref.schema.json",
  "allowedProofRefPrefixes": [
    "evidence://",
    "artifact://",
    "ci-artifact://"
  ],
  "allowedVerificationCommandPrefixes": [
    "bash scripts/",
    "python3 scripts/",
    "gh run view "
  ],
  "requiredFieldsPerProofRef": [
    "id",
    "proofRef",
    "evidenceType",
    "workItemId",
    "owner",
    "category",
    "issuer",
    "capturedAt",
    "expiresAt",
    "redactionBoundary",
    "verificationCommand",
    "artifactHash",
    "sourceBinding"
  ],
  "requiredSourceBindingFields": [
    "commit",
    "workQueueSha256",
    "occurrenceIds"
  ],
  "requiredRedactionBoundary": "redacted_no_secret_values",
  "forbiddenProofFragments": [
    "placeholder",
    "changeme",
    "dummy",
    "sample",
    "fake",
    "dry-run",
    "localhost",
    "local only",
    "debug",
    "token assignment marker",
    "secret assignment marker",
    "password assignment marker",
    "database dsn assignment marker",
    "private key block marker"
  ],
