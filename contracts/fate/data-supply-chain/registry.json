{
  "schemaVersion": 1,
  "apiVersion": "fatecat.tradecatlabs/v1",
  "description": "FateCat 数据供应链注册表。登记数据产品、典籍语料、vendor 快照、benchmark 与导出边界；不保存原始大文件、真实用户数据或运行态输出。",
  "schemas": {
    "dataSupplyChain": "contracts/fate/data-supply-chain/schemas/data-supply-chain.schema.json",
    "dataset": "contracts/fate/evaluations/schemas/dataset.schema.json",
    "resource": "contracts/fate/capabilities/schemas/resource.schema.json"
  },
  "policies": {
    "rawPolicy": "raw 私有资料只可由 source_manifest 追溯，不得进入 public export 或 production runtime。",
    "canonicalPolicy": "canonical 数据进入仓库前必须有 source manifest、hash、用途和版权/许可状态。",
    "derivedPolicy": "golden、benchmark、规则索引等派生资产只能按 usageRole 使用，不得混入生产输入。",
    "vendorPolicy": "vendor 快照以 vendor_sources.json 为真相源，production_dependency 必须 spdx 且 productionUseAllowed=true。",
    "exportPolicy": "public export 只允许 included 或 manifest_only 且通过 gate 的资产；review_required/blocked 不得作为默认公开分发承诺。"
  },
  "assets": [
    {
      "resourceType": "DataSupplyChainAsset",
      "apiVersion": "fatecat.tradecatlabs/v1",
      "id": "asset.locations.global",
      "name": "全球出生地点与 IANA 时区目录",
      "assetType": "location_catalog",
      "domain": "location",
      "lifecycleLayer": "canonical",
      "usageRole": "production_input",
      "status": "available",
      "privacyClass": "non_personal",
      "source": {
        "type": "tracked_data_product",
        "owner": "domains/fate-analysis/data-products/locations",
        "sourceLock": "domains/fate-analysis/data-products/locations/sources.lock.json"
      },
      "paths": [
        {
          "path": "domains/fate-analysis/data-products/locations/location_catalog.ndjson.gz",
          "role": "runtime_input",
          "required": true,
          "sha256": "cb7ddb82d59e7e77a65360ebb892ed177044714ca25e013c0685cd0819f33077"
        },
        {
          "path": "domains/fate-analysis/data-products/locations/manifest.json",
          "role": "data_product_manifest",
          "required": true,
          "sha256": "67d782f997124bfa4c17188e0bb8a6bfec660105f318de824e07f1217f41c6b0"
        },
        {
          "path": "domains/fate-analysis/data-products/locations/sources.lock.json",
          "role": "source_lock",
          "required": true,
          "sha256": "f5829463a646554ffec0c9d3ff26877e8a36520f7b453724bd255f34cd78238f"
        }
      ],
      "manifests": [
        "domains/fate-analysis/data-products/locations/manifest.json",
        "domains/fate-analysis/data-products/locations/sources.lock.json"
      ],
      "hashPolicy": "path_sha256_and_pinned_source_lock",
      "licensePolicy": {
        "licenseStatus": "mixed",
        "auditRequired": false,
        "productionUseAllowed": true,
        "distributionAllowed": true,
        "evidencePaths": [
          "domains/fate-analysis/data-products/locations/README.md",
          "domains/fate-analysis/data-products/locations/sources.lock.json"
        ]
      },
      "exportPolicy": {
        "status": "included",
        "allowedInPublicExport": true,
        "reason": "WTFPL 行政区层级与 CC-BY-4.0 GeoNames 派生目录，不含用户输入；公开分发必须保留来源归属。"
      },
      "productionEligibility": {
        "status": "allowed",
        "reason": "生产运行用于稳定地点 ID、WGS84 坐标、IANA 时区和消歧；运行时索引由该只读目录确定性构建。"
      },
      "verification": {
        "commands": [
          ".venv/bin/python -m pytest -q tests/regression/test_location.py tests/regression/test_location_catalog.py",
          "bash scripts/data-supply-chain-gate.sh"
        ],
        "externalConnectivity": "not_required"
      },
      "metadata": {
        "owner": "domains/fate-analysis/data-products/locations",
        "risk": "GeoNames 与行政区数据均为中心点近似；coordinatePrecision 必须随结果返回，parent_centroid 不得包装为精确出生坐标。"
      }
    },
